# INSECURE LOCAL EVALUATION ONLY; replace all secrets for production.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
POSTGRES_PASSWORD=portal
BETTER_AUTH_SECRET=INSECURE-local-auth-secret-change-me-123456
PORTAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
PORTAL_PUBLIC_URL=http://localhost:3000
KONG_ADMIN_URL=http://localhost:8001
KONG_ADMIN_TOKEN=
KONG_PROXY_INTERNAL_URL=http://localhost:8000
KONG_PROXY_PUBLIC_URL=http://localhost:8000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
SEED_SAMPLE=true

# Server :4000 is published only on 127.0.0.1. Only the immediate portal peer
# may supply a forwarded client IP. Compose uses its DNS name "portal"; for
# pnpm dev the portal connects from localhost. DNS failures disable trust.
PORTAL_PROXY_HOST=localhost
