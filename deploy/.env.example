# INSECURE LOCAL EVALUATION ONLY; replace all secrets for production.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
POSTGRES_PASSWORD=portal
BETTER_AUTH_SECRET=INSECURE-local-auth-secret-change-me-123456
PORTAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
PORTAL_PUBLIC_URL=http://localhost:3000
KONG_ADMIN_URL=
# Compose sets the bundled hint automatically; it does not save a connection.
PORTAL_BUNDLED_KONG_ADMIN_URL=
# Set KONG_ADMIN_URL only for environment-managed configuration.
# In Compose use http://kong:8001; with pnpm dev use http://localhost:8001.
# For an external PostgreSQL-backed Kong 3.9, set KONG_WORKER_CONSISTENCY=strict
# on Kong itself so newly imported ACLs apply to the first try-it request.
KONG_ADMIN_TOKEN=
# Kong must enable request tracing before the portal can configure OTLP export.
KONG_TRACING_INSTRUMENTATIONS=request,router,balancer,plugin_rewrite,plugin_access,plugin_header_filter
KONG_TRACING_SAMPLING_RATE=1
PORTAL_TRACE_INGEST_URL=http://server:4000/api/v1/internal/traces/kong
# Blank uses http://kong:8000 in Compose, http://localhost:8000 in pnpm dev.
KONG_PROXY_INTERNAL_URL=
KONG_PROXY_PUBLIC_URL=http://localhost:8000
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_SAMPLE=false

# Server :4000 is published only on 127.0.0.1. Only the immediate portal peer
# may supply a forwarded client IP. Compose uses its DNS name "portal"; for
# pnpm dev the portal connects from localhost. DNS failures disable trust.
PORTAL_PROXY_HOST=localhost

# SMTP fallback while no mail settings are saved in the admin UI.
# Compose defaults to the Mailpit service (UI: http://127.0.0.1:8025).
# For pnpm dev use SMTP_HOST=localhost and expose Mailpit port 1025 locally.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Developer Portal
SMTP_SENDER_ADDRESS=noreply@example.com
# Optional server ruleset override: mount the file and set this on the server service.
# PORTAL_LINT_RULESET=/etc/portal/ruleset.yaml

# Plan counters: cluster persists counters in Kong Postgres; local keeps per-node counters.
PORTAL_RATE_LIMIT_POLICY=cluster
