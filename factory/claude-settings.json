{
  "permissions": {
    "allow": [
      "Bash(node scripts/factory.mjs:*)",
      "Bash(node scripts/sync-agents.mjs:*)",
      "Bash(orca:*)",
      "Bash(pnpm:*)",
      "Bash(npx --yes pnpm@10:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(docker compose:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push origin feat/:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin HEAD\\:main:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
