{
  "name": "@portal/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.ingress.json && node dist/start.js dev",
    "build": "tsc -p tsconfig.ingress.json && next build",
    "start": "node dist/start.js start",
