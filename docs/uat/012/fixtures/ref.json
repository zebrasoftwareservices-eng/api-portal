{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders API",
    "version": "bad-ref"
  },
  "servers": [
    {
      "url": "http://localhost:8000/sample"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Missing"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An order"
          }
        }
      }
    }
  }
}