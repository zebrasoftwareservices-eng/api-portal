{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders API",
    "version": "bad-parameter"
  },
  "servers": [
    {
      "url": "http://localhost:8000/sample"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "responses": {
          "200": {
            "description": "Orders"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "responses": {
          "200": {
            "description": "An order"
          }
        }
      }
    }
  }
}